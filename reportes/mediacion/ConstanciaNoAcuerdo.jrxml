					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Usuario(a)]]></text>
			</staticText>
			<staticText>
				<reportElement x="290" y="347" width="148" height="14" uuid="feecb3e3-8f4d-4239-9611-1c1b13d8ca6b"/>
				<textElement textAlignment="Center">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Invitado(a)]]></text>
			</staticText>
			<textField>
				<reportElement x="2" y="234" width="484" height="75" uuid="94e658c0-e420-4979-b537-0f7ab26c0169">
					<property name="com.jaspersoft.studio.unit.firstLineIndent" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" markup="html">
					<font size="10"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0" firstLineIndent="60"/>
				</textElement>
				<textFieldExpression><![CDATA["En atención a lo anterior, y a petición de <b>LAS PARTES</b> se levanta la presente por triplicado, firmando al calce las personas que en ella intervinieron, en tres tantos originales, quedando dos a su disposición y uno más se ordena agregar al expediente en que se actúa para los efectos legales y administrativos a que haya lugar."]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="30" y="406" width="200" height="1" uuid="e27e8d0e-3ff0-44a0-aa64-645d4f94dc78"/>
			</line>
			<line>
				<reportElement x="280" y="406" width="200" height="1" uuid="20b0dea8-f2f2-4a15-9d43-77e3b9081c64"/>
			</line>
			<textField>
				<reportElement x="30" y="413" width="200" height="30" uuid="e37a083a-c84f-4192-8a2f-c09c2d08e79c"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{mediador}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="280" y="413" width="200" height="30" uuid="fb0ecd8a-dced-4e15-ac4e-32b3f8fd3b4a"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[LIC. ROSA MARÍA MORALES CISNEROS]]></text>
			</staticText>
			<textField>
				<reportElement x="27" y="443" width="200" height="51" uuid="60d76214-e5cd-452c-8a80-4b6e9e9c4790"/>
				<textElement textAlignment="Center">
					<font isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["MEDIADOR DEL CENTRO DE JUSTICIA ALTERNATIVA DEL TRUBUNAL SUPERIOR DE JUSTICIA DEL PODER JUDICIAL DEL ESTADO DE PUEBLA"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="280" y="443" width="200" height="51" uuid="0320b807-c0c2-4cf9-898a-ca5a2e6efe77"/>
				<textElement textAlignment="Center">
					<font isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["TITULAR DEL CENTRO DE JUSTICIA ALTERNATIVA DEL TRIBUNAL SUPERIOR DE JUSTICIA DEL PODER JUDICIAL DEL ESTADO DE PUEBLA"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-1" y="0" width="484" height="225" uuid="651266fd-57d1-41b9-b63e-84f0769294ed">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.firstLineIndent" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" markup="html">
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0" firstLineIndent="60"/>
				</textElement>
				<textFieldExpression><![CDATA["En ciudad Judicial, Puebla: siendo las "+$V{v_fecha_actual}+", con fundamento en los artículos 2, 7, 15 fracción VII, 23 y 27 de LEY DE MECANISMOS ALTERNATIVOS DE SOLUCIÓN DE CONTROVERSIAS DEL ESTADO LIBRE Y SOBERANO DE PUEBLA; la que suscribe <b>LIC. ROSA MARÍAMORALES CISNEROS, Directora del Centro de Justicia Alternativa del Poder Judicial del Estado de Puebla</b>, auxiliada por el <b>LIC. "+$F{mediador}+ " Mediador(a) </b>adscrito a este Órgano y ante la presencia del (de la) <b>"+$F{usuario_nombre}+"</b> ,  en su carácter de <b> USUARIO (A)</b> y del (de la) <b>"+$F{invitado_nombre}+"</b>, en su carácter de <b>INVITADO (A)</b>; hago constar que las anteriormente citadas comparecieron ante este Centro a someterse al <B>PROCEDIMIENTO DE MEDIACIÓN</b>, sin que hayan <b> CELEBRADO CONVENIO O ACTA</b> alguna que forme parte integrante del expediente en el que se actúa, toda vez que al ser escuchadas <b>LAS PARTES</b> manifiestan dentro de sus propuestas que no son proporcionables una respecto de otra impidiendo llegar a algún acuerdo, por lo que se dejan a salvo los derechos de los intervinientes para hacerlos valer en la vía que consideren oportuna."]]></textFieldExpression>
			</textField>
		</band>
	</detail>
