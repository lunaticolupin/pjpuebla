<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="AceptacionServicioPsicologia" pageWidth="612" pageHeight="792" columnWidth="486" leftMargin="70" rightMargin="56" topMargin="56" bottomMargin="28" uuid="14c5d9c7-9f45-4e1d-9b9c-a1f93ab34d59">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="medicacion"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="expediente" class="java.lang.String"/>
	<parameter name="p_image_path" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["images"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT e.folio as expediente,
		core.nombre_persona(p1.id) as usuario_nombre,
		core.nombre_persona(p2.id) as invitado_nombre,
		core.nombre_persona(U.persona_id) as mediador,
		s.folio as folio_solicitud
		FROM mediacion.expediente e
		join mediacion.solicitud s on s.id = e.solicitud_id  
		join core.persona p1 on p1.id = s.usuario_persona_id 
		join core.persona p2 on p2.id = s.invitado_persona_id
		join mediacion.mediador m on m.id = e.mediador_id 
		join core.usuario u on u.persona_id  = m.usuario_id
		where  e.folio = $P{expediente}]]>
	</queryString>
	<field name="expediente" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="expediente"/>
		<property name="com.jaspersoft.studio.field.label" value="expediente"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="expediente"/>
	</field>
	<field name="usuario_nombre" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="usuario_nombre"/>
		<property name="com.jaspersoft.studio.field.label" value="usuario_nombre"/>
	</field>
	<field name="invitado_nombre" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="invitado_nombre"/>
		<property name="com.jaspersoft.studio.field.label" value="invitado_nombre"/>
	</field>
	<field name="mediador" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="mediador"/>
		<property name="com.jaspersoft.studio.field.label" value="mediador"/>
	</field>
	<field name="folio_solicitud" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="folio_solicitud"/>
		<property name="com.jaspersoft.studio.field.label" value="folio_solicitud"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="solicitud"/>
	</field>
	<variable name="v_hora_fecha_constancia" class="java.lang.String">
		<variableExpression><![CDATA[$V{v_number_spell}.format(new Date().getHours())+" horas y "+ $V{v_number_spell}.format(new Date().getMinutes() )+" minutos del día "+
new SimpleDateFormat("EEEE d 'de' MMMM  'de' yyyy ", $P{REPORT_LOCALE}).format(new Date())]]></variableExpression>
	</variable>
	<variable name="v_number_spell" class="com.ibm.icu.text.RuleBasedNumberFormat">
		<initialValueExpression><![CDATA[new com.ibm.icu.text.RuleBasedNumberFormat($P{REPORT_LOCALE}, com.ibm.icu.text.RuleBasedNumberFormat.SPELLOUT)]]></initialValueExpression>
	</variable>
	<variable name="v_fecha_actual" class="java.lang.String">
		<variableExpression><![CDATA[new SimpleDateFormat("h:mm a 'del' dd 'de' MMMM 'de' yyyy").format(new Date())]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="74" splitType="Stretch">
			<image>
				<reportElement x="0" y="0" width="180" height="60" uuid="fc22272a-6b3c-4001-bee8-be32ed561ce9"/>
