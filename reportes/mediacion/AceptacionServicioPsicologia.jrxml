			</image>
		</band>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band height="55" splitType="Stretch">
			<textField>
				<reportElement x="0" y="-6" width="270" height="60" uuid="6ee7be92-ecdc-4193-868d-888263d5d7a5">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Left" markup="html">
					<font size="11" isBold="false"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["<b>ACEPTACIÓN DEL SERVICIO DE PSICOLOGIA</b><br>A QUIEN CORRESPONDA <br>PRESENTE"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="270" y="-5" width="214" height="50" uuid="9cb7fc6b-6bbd-49af-a06f-00fa5b27d4ef">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Right" markup="html">
					<font size="11" isBold="false"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["EXPEDIENTE: <b>"+$F{expediente}+"</b><br>MEDIADOR: "+$F{mediador}]]></textFieldExpression>
			</textField>
		</band>
	</columnHeader>
	<detail>
		<band height="463" splitType="Stretch">
			<textField>
				<reportElement x="0" y="20" width="484" height="50" uuid="a61c988a-cb26-4095-81b0-31efb8ca6999">
					<property name="com.jaspersoft.studio.unit.firstLineIndent" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" markup="html">
					<font size="9"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0" firstLineIndent="0"/>
				</textElement>
				<textFieldExpression><![CDATA["Los suscritos C. "+$F{usuario_nombre}+"y C. "+$F{invitado_nombre}+"l”, manifestamos que es nuestra voluntad solicitar los servicios de psicología que presta en forma gratuita este Centro Justicia Alternativa para llevar a cabo los procedimientos de mediación; a través de su personal calificado."]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="41" y="295" width="150" height="1" uuid="39542c9b-8f8d-4c95-8f78-42b8b7d1e4a7"/>
			</line>
			<line>
				<reportElement x="290" y="293" width="150" height="1" uuid="5c4a8eda-aa01-47a5-b7a5-d5804eb12e2c"/>
			</line>
			<textField>
				<reportElement x="40" y="298" width="150" height="16" uuid="c6342e35-9de2-4132-8e61-0b0ccc1fff6f"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{usuario_nombre}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="290" y="296" width="148" height="16" uuid="b3875407-28d1-4b2e-85b9-5fb343576833"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{invitado_nombre}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="40" y="314" width="150" height="20" uuid="0c40b703-5c1f-4418-8b01-06081a9e3316"/>
				<textElement textAlignment="Center" markup="none">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Usuario(a)]]></text>
			</staticText>
			<staticText>
				<reportElement x="290" y="312" width="148" height="14" uuid="feecb3e3-8f4d-4239-9611-1c1b13d8ca6b"/>
				<textElement textAlignment="Center">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Invitado(a)]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="70" width="484" height="60" uuid="94e658c0-e420-4979-b537-0f7ab26c0169">
					<property name="com.jaspersoft.studio.unit.firstLineIndent" value="px"/>
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" markup="html">
					<font size="9"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0" firstLineIndent="60"/>
				</textElement>
				<textFieldExpression><![CDATA["La atención podrá incluir: intervención en crisis, orientación psicológica individual, de pareja y familiar y se podrá dar como una asistencia previa a la mediación, durante la mediación, o una vez concluido el procedimiento, como sesión de seguimiento en caso de ser necesario ."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="131" width="484" height="60" uuid="26484164-67ba-4244-b6c1-bf242c695dde">
					<property name="com.jaspersoft.studio.unit.firstLineIndent" value="px"/>
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" markup="html">
					<font size="9"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0" firstLineIndent="60"/>
				</textElement>
				<textFieldExpression><![CDATA["Así mismo, por este medio y a la firma del presente, declaramos y hacemos saber que, deslindamos de toda responsabilidad civil, penal, mercantil o de cualquier otra naturaleza a este Centro de Justicia Alternativa perteneciente al Poder Judicial del Estado de Puebla, ante quien iniciamos este procedimiento."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="218" width="484" height="26" uuid="486b6cf8-ff2e-406e-a666-a984b435a4bb">
					<property name="com.jaspersoft.studio.unit.firstLineIndent" value="px"/>
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" markup="html">
					<font size="9"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0" firstLineIndent="120"/>
				</textElement>
				<textFieldExpression><![CDATA["H. Puebla dezaragoza, Puebla a "+$V{v_fecha_actual}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
