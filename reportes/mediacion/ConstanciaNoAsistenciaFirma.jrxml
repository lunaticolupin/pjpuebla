				<textElement textAlignment="Center">
					<font size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["CONSTANCIA DE NO ASISTENCIA A FIRMA"]]></textFieldExpression>
			</textField>
		</band>
	</columnHeader>
	<detail>
		<band height="500" splitType="Stretch">
			<textField>
				<reportElement x="1" y="167" width="484" height="110" uuid="94e658c0-e420-4979-b537-0f7ab26c0169">
					<property name="com.jaspersoft.studio.unit.firstLineIndent" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" markup="html">
					<font size="10"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0" firstLineIndent="60"/>
				</textElement>
				<textFieldExpression><![CDATA["En atención a lo anterior, se levanta la presente por duplicado, en presencia y a petición del (de la) "+$F{usuario_nombre}+" en su carácter de USUARIO, quien se identifica Credencial para votar expedida por el Instituto Nacional Electoral con número: "+$F{num_identificacion}+" previo acuse de recibido, y el otro tanto se ordena agregar al expediente en que se actúa para los efectos legales y administrativos a los que haya lugar; dando con este acto por terminado el presente procedimiento de mediación."]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="130" y="336" width="200" height="1" uuid="20b0dea8-f2f2-4a15-9d43-77e3b9081c64"/>
			</line>
			<staticText>
				<reportElement x="130" y="343" width="200" height="30" uuid="fb0ecd8a-dced-4e15-ac4e-32b3f8fd3b4a"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[LIC. ROSA MARÍA MORALES CISNEROS]]></text>
			</staticText>
			<textField>
				<reportElement x="130" y="373" width="200" height="51" uuid="0320b807-c0c2-4cf9-898a-ca5a2e6efe77"/>
				<textElement textAlignment="Center">
					<font isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["TITULAR DEL CENTRO DE JUSTICIA ALTERNATIVA DEL TRIBUNAL SUPERIOR DE JUSTICIA DEL PODER JUDICIAL DEL ESTADO DE PUEBLA"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="1" y="3" width="484" height="160" uuid="651266fd-57d1-41b9-b63e-84f0769294ed">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.firstLineIndent" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" markup="html">
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0" firstLineIndent="0"/>
				</textElement>
				<textFieldExpression><![CDATA["En Ciudad Judicial, Puebla; siendo las "+$V{v_fecha_actual}+" con fundamento en los artículos 2, 7, 15 fracción VII, 23 y 27 de LEY DE MECANISMOS ALTERNATIVOS DE SOLUCIÓN DE CONTROVERSIAS DEL ESTADO LIBRE Y SOBERANO DE PUEBLA; la que suscribe <b>	LIC. ROSA MARÍA MORALES CISNEROS, Directora del Centro de Justicia Alternativa del Poder Judicial del Estado de Puebla,</b> hago constar que el(la) C. "+$F{invitado_nombre}+" en su caracter de INVITADO(A) segun consta en las documentales que integran el expediente Número <b>"+$F{expediente}+"</b> no compareció en la día y hora señalados para la firma del Acuerdo a las oficinas que ocupa este Centro de Justicia Alternativa, a fin de lograr una amigable solución al conflicto de carácter "+$F{materia}+", en el que está involucrado, para las que fueron señaladas "+$V{v_fecha_sesion}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
