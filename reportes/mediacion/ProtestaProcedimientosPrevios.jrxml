				<textElement textAlignment="Left" verticalAlignment="Top" markup="html">
					<font size="9"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0" firstLineIndent="0"/>
				</textElement>
				<textFieldExpression><![CDATA["Los C. "+$F{usuario_nombre_completo}+" , y "+$F{invitado_nombre_completo} +" , manifestamos bajo protesta de decir verdad que SI &emsp;&emsp; NO &emsp; hemos iniciado juicio, denuncia o trámite administrativo previo sobre el presente asunto, por lo que hacemos las siguientes precisiones: <br><bt> ( Especificar número de expediente, autoridad conocedora, estado procesal y asunto)"]]></textFieldExpression>
			</textField>
