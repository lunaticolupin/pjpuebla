				<textElement textAlignment="Center">
					<font size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["FORMATO NO ACEPTACIÓN DEL SERVICIO DE MEDIACIÓN"]]></textFieldExpression>
			</textField>
		</band>
	</columnHeader>
	<detail>
		<band height="499" splitType="Stretch">
			<textField>
				<reportElement x="0" y="10" width="480" height="160" uuid="a61c988a-cb26-4095-81b0-31efb8ca6999">
					<property name="com.jaspersoft.studio.unit.firstLineIndent" value="px"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="html">
					<font size="9"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0" firstLineIndent="0"/>
				</textElement>
				<textFieldExpression><![CDATA["A QUIEN CORRESPONDA <br> PRESENTE <br><br> Los suscritos C."+$F{usuario_nombre_completo}+" y C. "+$F{invitado_nombre_completo}+" , manifestamos que es nuestra voluntad de NO solicitar los servicios que presta en forma gratuita este Centro para llevar a cabo los procedimientos de mediacion; de igual manera y con fundamento en los articulos 84 fracción primera coma 85 y 86 de la Ley Orgánica del Poder Judicial del Estado De Puebla, se nos ha informado sobre los alcances jurídicos del procedimiento y que éste se rige por los principios de voluntariedad, legalidad, confidencialidad, neutralidad, imparcialidad, equidad y demas señalados por la Ley de Mecanismos Alternativos de Solución de Controversias del Estado Libre y Soberano de Puebla, asi como las reglas derechos y obligaciones del procedimiento de mediación al que hemos decidido NO sujetarnos. <br>"]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="16" y="397" width="150" height="1" uuid="39542c9b-8f8d-4c95-8f78-42b8b7d1e4a7"/>
			</line>
			<line>
				<reportElement x="325" y="397" width="150" height="1" uuid="5c4a8eda-aa01-47a5-b7a5-d5804eb12e2c"/>
			</line>
			<textField>
				<reportElement x="15" y="400" width="150" height="16" uuid="c6342e35-9de2-4132-8e61-0b0ccc1fff6f"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{usuario_nombre_completo}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="325" y="400" width="148" height="16" uuid="b3875407-28d1-4b2e-85b9-5fb343576833"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{invitado_nombre_completo}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="15" y="416" width="150" height="20" uuid="0c40b703-5c1f-4418-8b01-06081a9e3316"/>
				<textElement textAlignment="Center" markup="none">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Usuario(a)]]></text>
			</staticText>
			<staticText>
				<reportElement x="325" y="416" width="148" height="14" uuid="feecb3e3-8f4d-4239-9611-1c1b13d8ca6b"/>
				<textElement textAlignment="Center">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Invitado(a)]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="180" width="480" height="100" uuid="b70920da-aa21-4d74-b774-d93ca035e765">
					<property name="com.jaspersoft.studio.unit.firstLineIndent" value="px"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="html">
					<font size="9"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0" firstLineIndent="60"/>
				</textElement>
				<textFieldExpression><![CDATA["Asi mismo, por este medio y a la firma del presente, declaramos y hacemos saber que, deslindamos de toda responsabilidad civil, penal, mercantil o de cualquier otra naturaleza al Centro de Justicia Alternativa perteneciente al Poder Judicial del Estado de Puebla y que somos sabedores que en términos del articulo 846 del Código del Procedimiento Civiles para el Estado de Puebla se sancionará civil y penalmente a quien utilice la mediación con ánimo de engañar a una o ambas partes."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="300" width="480" height="40" uuid="61194ac7-2e88-4a0d-b72d-b3792978ac4a">
					<property name="com.jaspersoft.studio.unit.firstLineIndent" value="px"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="html">
					<font size="9"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.0" firstLineIndent="90"/>
				</textElement>
				<textFieldExpression><![CDATA["H. Puebla de Zaragoza, Puebla a "+$V{v_fecha_actual}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="353" width="480" height="26" uuid="cd3dfdc8-b8d7-4153-a00f-abeaff3ca4d8"/>
				<textElement textAlignment="Center">
					<font isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["ACEPTAMOS DE CONFORMIDAD"]]></textFieldExpression>
			</textField>
